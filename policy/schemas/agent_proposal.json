{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentProposal",
  "type": "object",
  "required": [
    "agent",
    "candidate_id",
    "parent_id",
    "proposed_passes",
    "reason",
    "expected_effect",
    "risk",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "string",
      "enum": ["ir_tuner", "hw_tuner"]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "proposed_passes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{2,32}$"
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 512
    },
    "expected_effect": {
      "type": "string",
      "maxLength": 256
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "target_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simd_width": { "type": "integer", "enum": [128, 256, 512] },
        "prefer_vector_width": { "type": "string", "enum": ["128", "256", "512"] },
        "unroll_factor": { "type": "integer", "minimum": 1, "maximum": 16 },
        "inline_threshold": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
